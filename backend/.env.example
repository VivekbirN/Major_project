# Server
PORT=5000

# MongoDB — replace with your Atlas connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/foodchain_ai

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production
JWT_EXPIRES_IN=24h

# Environment
NODE_ENV=development

# ML Service
FASTAPI_HOST=localhost
FASTAPI_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173
